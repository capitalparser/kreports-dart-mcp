# DART OpenAPI Key (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=your_api_key_here

# Remote MCP endpoint auth token. Use a long random value in production.
KREPORTS_MCP_TOKEN=replace_with_long_random_token

# Runtime mode:
# - readonly: MCP endpoint. Never calls DART collectors.
# - collector: private backfill worker. Requires DART_API_KEY.
KREPORTS_RUNTIME_MODE=readonly

# Optional explicit DB URL. In Docker, mount the dataset at /data/kreports.db.
DB_URL=sqlite:////data/kreports.db
