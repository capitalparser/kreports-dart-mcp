# Private collector only. Keep this file out of the public MCP deployment.
KREPORTS_RUNTIME_MODE=collector
DART_API_KEY=replace_with_opendart_key
DB_URL=sqlite:////path/to/writable/kreports.db

# Select and validate an external raw store before enabling raw backfill.
RAW_STORAGE_BACKEND=replace_with_external_backend
RAW_STORAGE_BUCKET=replace_with_private_bucket
RAW_STORAGE_PREFIX=dart/raw
RAW_STORAGE_KEEP_INLINE=false
RAW_BACKFILL_ENABLED=false
