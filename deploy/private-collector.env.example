# Private collector only. Keep this file out of the public MCP deployment.
KREPORTS_RUNTIME_MODE=collector
DART_API_KEY=replace_with_opendart_key
# Optional additional operator-owned keys, one raw key per line. The file must
# be a regular owner-only file (chmod 600) outside Git.
# DART_API_KEYS_FILE=/absolute/private/path/to/dart-api-keys
DB_URL=sqlite:////path/to/writable/kreports.db

# Select and validate an external raw store before enabling raw backfill.
RAW_STORAGE_BACKEND=replace_with_external_backend
RAW_STORAGE_BUCKET=replace_with_private_bucket
RAW_STORAGE_PREFIX=dart/raw
RAW_STORAGE_KEEP_INLINE=false
KREPORTS_ENABLE_RAW_BACKFILL=0

# Source-archive apply proves the named rclone Drive remote has a dedicated
# client_id. Configure it with `rclone config` (preferred), or use a backend
# override that rclone actually consumes. Never put a client secret or token
# in this application env file.
# Reuse an existing operator-owned rclone/Drive API pipeline by pointing to its
# owner-only config file. KReports passes this exact path to every rclone call;
# it never copies or prints the OAuth credentials stored in that file.
# RAW_STORAGE_RCLONE_CONFIG=/absolute/private/path/to/rclone.conf
# RCLONE_CONFIG_KREPORTS_DRIVE_CLIENT_ID=replace_with_dedicated_client_id
# RCLONE_DRIVE_CLIENT_ID=replace_with_dedicated_client_id
RAW_STORAGE_RCLONE_TPSLIMIT=0.5
RAW_STORAGE_RCLONE_TPSLIMIT_BURST=1
RAW_STORAGE_DRIVE_RATE_LIMIT_RETRIES=2
RAW_STORAGE_DRIVE_RATE_LIMIT_COOLDOWN_SECONDS=60
RAW_STORAGE_DRIVE_RATE_LIMIT_MAX_COOLDOWN_SECONDS=900
# Set 0 only for high-volume raw-source collection: accept a successful
# content-addressed copy without immediate rclone-cat readback. Candidate and
# release DB artifacts remain strict regardless of this setting.
RAW_STORAGE_VERIFY_READBACK_ON_SUCCESS=1
# Optional one-off diagnostic override; keep unset for normal backfills.
# KREPORTS_DRIVE_ALLOW_SHARED_CLIENT_DIAGNOSTIC=1

# Continuous source-archive supervisor. The DB remains read-only input; raw
# bytes and parse packages go to the immutable Drive archive above.
KREPORTS_SOURCE_ARCHIVE_DB=/absolute/path/to/candidate.db
KREPORTS_SOURCE_ARCHIVE_STATE_DIR=/absolute/path/to/source-archive-campaign
KREPORTS_SOURCE_ARCHIVE_UNIVERSE=all-annual-issuers
KREPORTS_SOURCE_ARCHIVE_YEARS="2021 2022 2023 2024 2025"
KREPORTS_SOURCE_ARCHIVE_SHARD_COUNT=64
KREPORTS_SOURCE_ARCHIVE_MAX_DART_CALLS=100
KREPORTS_SOURCE_ARCHIVE_PARTIAL_RETRY_SECONDS=86400
# For shared-worker runs, assign a unique year set and a distinct local state
# directory per worker. The shared Drive prefix stays identical.
# KREPORTS_SOURCE_ARCHIVE_YEARS="2021"
# KREPORTS_SOURCE_ARCHIVE_STATE_DIR=/absolute/path/to/source-archive-campaign-worker-a

# Inactive local DB lifecycle. This is separate from source-archive retention.
# Only a verified Drive copy may be pruned after the configured grace period.
KREPORTS_ENABLE_DB_ARCHIVE=0
KREPORTS_DB_ARCHIVE_PREFIX=KReports Data Lake/db-archive
KREPORTS_DB_ARCHIVE_GRACE_DAYS=7
KREPORTS_DB_ARCHIVE_MIN_FREE_GIB=20
KREPORTS_DB_ARCHIVE_TARGET_FREE_GIB=25
