# Copy to a private local file such as ~/.config/kreports/worker-a.env.
# Never upload the completed file, API keys, or OAuth tokens to Google Drive.

KREPORTS_RUNTIME_MODE=collector
KREPORTS_ENABLE_RAW_BACKFILL=1

# Your own OpenDART credential.
DART_API_KEY=replace_with_your_opendart_key

# Central readonly candidate DB snapshot downloaded from the coordinator.
KREPORTS_SOURCE_ARCHIVE_DB=/absolute/path/to/kreports-candidate-readonly.db

# Shared Drive archive root. All workers use the same remote/prefix, but their
# local state directory below must be unique per worker.
RAW_STORAGE_BACKEND=drive
RAW_STORAGE_DRIVE_REMOTE=your-drive-remote:
RAW_STORAGE_PREFIX=KReports Data Lake/source-archive-v3-all-annual-issuers
RAW_STORAGE_RCLONE_CONFIG=/absolute/private/path/to/rclone.conf

# Fast source-only success path. Do not use this setting for DB release archives.
RAW_STORAGE_VERIFY_READBACK_ON_SUCCESS=0
RAW_STORAGE_COMMAND_TIMEOUT_SECONDS=90
RAW_STORAGE_RCLONE_TPSLIMIT=2
RAW_STORAGE_RCLONE_TPSLIMIT_BURST=4
RAW_STORAGE_DRIVE_RATE_LIMIT_RETRIES=2
RAW_STORAGE_DRIVE_RATE_LIMIT_COOLDOWN_SECONDS=60
RAW_STORAGE_DRIVE_RATE_LIMIT_MAX_COOLDOWN_SECONDS=900

# Assignment from ASSIGNMENTS.md: replace worker-a and 2021 only as allocated.
KREPORTS_SOURCE_ARCHIVE_STATE_DIR=/absolute/path/to/kreports-source-archive/worker-a
KREPORTS_SOURCE_ARCHIVE_UNIVERSE=all-annual-issuers
KREPORTS_SOURCE_ARCHIVE_YEARS="2021"
KREPORTS_SOURCE_ARCHIVE_SHARD_COUNT=64
KREPORTS_SOURCE_ARCHIVE_MAX_DART_CALLS=500
KREPORTS_SOURCE_ARCHIVE_PARTIAL_RETRY_SECONDS=86400
